{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "climate-fund-watch.vercel.app"
        }
      ],
      "destination": "https://cfw.mkweli.tech/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "climate-fund-watch.vercel.app"
        }
      ],
      "destination": "https://cfw.mkweli.tech/:path*",
      "permanent": true
    }
  ]
}
